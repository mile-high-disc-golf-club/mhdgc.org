{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // content.config.ts imports design-system files with their extension, as Node needs.
    "allowImportingTsExtensions": true
  },
  "include": [
    "content.config.ts",
    "app/.server/**/*.ts",
    "app",
    "shared",
    ".react-router/types/**/*",
    ".storybook/vitest.setup.ts",
    ".storybook/preview.tsx",
    ".storybook/router-decorator.tsx"
  ],
  "exclude": [".react-router/types/+server-build.d.ts"]
}
