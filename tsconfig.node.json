{
  // Build config files, run by Node.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Lets vite.config.ts import content.config.ts with its extension, as Node needs.
    "allowImportingTsExtensions": true
  },
  "include": [
    "app/content.ts",
    "app/design-system/components/icons.ts",
    "app/design-system/theme/colors.ts",
    "app/site.ts",
    "shared/content-assets.ts",
    "shared/security-headers.ts",
    "scripts/**/*.ts",
    "*.config.ts",
    "*.config.test.ts",
    ".storybook/**/*.ts"
  ],
  "exclude": [".storybook/vitest.setup.ts"]
}
