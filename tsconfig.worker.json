{
  // The Worker entry and API routes, with Workers runtime types instead of the DOM.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    // worker-configuration.d.ts is generated by `bun run cf-typegen` and committed.
    // It holds the Workers runtime types and `Env` built from wrangler.jsonc.
    "types": ["./worker-configuration.d.ts", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["worker", "shared", ".react-router/types/+server-build.d.ts"]
}
